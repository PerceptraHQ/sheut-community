{
  "name": "sheut",
  "private": true,
  "version": "0.1.0-alpha",
  "description": "A local-first cyber threat intelligence workbench.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerceptraHQ/sheut-community.git"
  },
  "bugs": {
    "url": "https://github.com/PerceptraHQ/sheut-community/issues"
  },
  "homepage": "https://github.com/PerceptraHQ/sheut-community#readme",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "corepack pnpm typecheck && corepack pnpm build:frontend",
    "build:frontend": "GOMAXPROCS=2 UV_THREADPOOL_SIZE=2 vite build && corepack pnpm check:bundle",
    "check": "corepack pnpm check:frontend && corepack pnpm check:rust && corepack pnpm build:frontend",
    "check:biome": "biome check .",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:desktop-icons": "node scripts/check-desktop-icons.mjs",
    "check:frontend": "corepack pnpm check:biome && corepack pnpm check:desktop-icons && corepack pnpm check:tauri-security && corepack pnpm lint:eslint && corepack pnpm typecheck && corepack pnpm test",
    "check:mitre-freshness": "node scripts/check-mitre-freshness.mjs",
    "check:release": "corepack pnpm check:push && corepack pnpm check:mitre-freshness",
    "check:rust": "corepack pnpm lint:rust && corepack pnpm test:rust",
    "check:tauri-security": "node scripts/check-tauri-security.mjs",
    "check:push": "corepack pnpm check && corepack pnpm audit:js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "icons:desktop": "node scripts/generate-desktop-icons.mjs",
    "lint": "corepack pnpm lint:biome && corepack pnpm lint:eslint",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:rust": "cargo fmt --all -- --check && CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 cargo clippy --workspace --all-targets --all-features --locked -- -D warnings",
    "lint:rust:release": "cargo fmt --all -- --check && cargo clippy --release --workspace --all-targets --all-features --locked -- -D warnings",
    "measure:editor": "corepack pnpm build && node scripts/measure-editor-latency.mjs",
    "package:alpha:macos": "corepack pnpm tauri build --bundles dmg",
    "typecheck": "tsc --noEmit --pretty false && tsc --noEmit --pretty false -p tsconfig.node.json",
    "test": "vitest run --maxWorkers=1",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:rust": "CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 cargo test --workspace --all-targets --all-features --locked",
    "test:rust:release": "cargo test --release --workspace --all-targets --all-features --locked",
    "test:watch": "vitest --maxWorkers=1",
    "audit:js": "pnpm audit --audit-level high",
    "prepare": "husky",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tabler/icons-react": "3.46.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-subscript": "3.29.2",
    "@tiptap/extension-superscript": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-task-item": "3.29.2",
    "@tiptap/extension-task-list": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "cmdk": "1.1.1",
    "d3-drag": "3.0.0",
    "d3-force": "3.0.0",
    "d3-quadtree": "3.0.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/d3-drag": "3.0.7",
    "@types/d3-force": "3.0.10",
    "@types/d3-quadtree": "3.0.6",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
