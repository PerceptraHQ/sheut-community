{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheut",
  "version": "0.1.0-alpha",
  "identifier": "app.sheut.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sheut",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "center": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["default"],
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "isolation"
        }
      },
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Resource-Policy": "same-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Content-Type-Options": "nosniff"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "shortDescription": "Local-first cyber threat intelligence workbench",
    "longDescription": "Sheut helps analysts structure STIX intelligence, investigate threats visually, and produce reports while keeping community projects local-first.",
    "targets": "all",
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
