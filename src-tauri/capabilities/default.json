{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allowlisted Sheut application commands for the main desktop window",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-is-fullscreen",
    "core:window:allow-minimize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-get-telemetry-preference",
    "allow-set-telemetry-preference",
    "allow-record-telemetry-event",
    "allow-list-projects",
    "allow-list-graph-workspaces",
    "allow-list-graph-source-items",
    "allow-create-graph-workspace",
    "allow-load-graph-workspace",
    "allow-rename-graph-workspace",
    "allow-delete-graph-workspace",
    "allow-restore-graph-workspace",
    "allow-add-graph-workspace-items",
    "allow-remove-graph-workspace-items",
    "allow-save-graph-workspace-state",
    "allow-create-graph-visual-link",
    "allow-update-graph-visual-link",
    "allow-delete-graph-visual-link",
    "allow-load-graph-item-properties",
    "allow-preview-graph-relationship-draft",
    "allow-commit-graph-relationship-draft",
    "allow-list-stix-objects",
    "allow-list-stix-drafts",
    "allow-create-stix-draft",
    "allow-create-stix-revision-draft",
    "allow-update-stix-draft",
    "allow-create-stix-relationship-draft",
    "allow-update-stix-relationship-draft",
    "allow-delete-stix-draft",
    "allow-delete-stix-object",
    "allow-preview-stix-import",
    "allow-discard-stix-import-preview",
    "allow-commit-stix-import",
    "allow-preview-stix-export",
    "allow-discard-stix-export-preview",
    "allow-commit-stix-export",
    "allow-list-documents",
    "allow-get-mitre-catalog",
    "allow-list-mitre-catalog-statuses",
    "allow-preview-mitre-catalog-update",
    "allow-commit-mitre-catalog-update",
    "allow-reset-mitre-catalog",
    "allow-list-technique-observations",
    "allow-create-technique-observation",
    "allow-update-technique-observation",
    "allow-delete-technique-observation",
    "allow-preview-mitre-mapping-import",
    "allow-commit-mitre-mapping-import",
    "allow-export-mitre-mapping",
    "allow-preview-navigator-import",
    "allow-commit-navigator-import",
    "allow-export-navigator-projection",
    "allow-list-project-backups",
    "allow-create-project",
    "allow-update-project-default-tlp",
    "allow-create-document",
    "allow-list-report-templates",
    "allow-create-custom-report-template",
    "allow-list-guided-reports",
    "allow-list-report-project-data",
    "allow-create-guided-report",
    "allow-save-guided-report",
    "allow-get-guided-report-readiness",
    "allow-update-guided-report-section-disposition",
    "allow-upgrade-illicit-ecosystem-report",
    "allow-delete-guided-report",
    "allow-restore-guided-report",
    "allow-list-brand-profiles",
    "allow-create-brand-profile",
    "allow-update-brand-profile",
    "allow-pick-brand-asset",
    "allow-load-brand-asset",
    "allow-delete-document",
    "allow-restore-document",
    "allow-list-document-revisions",
    "allow-list-document-activity",
    "allow-compare-document-revisions",
    "allow-restore-document-revision",
    "allow-export-saved-document",
    "allow-export-guided-report",
    "allow-list-publication-records",
    "allow-reproduce-publication",
    "allow-pick-document-image",
    "allow-load-document-image",
    "allow-import-evidence-image",
    "allow-import-evidence-file",
    "allow-list-evidence-files",
    "allow-load-evidence-image",
    "allow-update-evidence-metadata",
    "allow-delete-evidence-file",
    "allow-create-passphrase-project",
    "allow-create-project-backup",
    "allow-load-document",
    "allow-save-document",
    "allow-render-saved-document",
    "allow-unlock-project",
    "allow-unlock-passphrase-project",
    "allow-lock-project",
    "allow-delete-project",
    "allow-restore-device-project-backup",
    "allow-restore-passphrase-project-backup",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://mitre.org/*" }, { "url": "https://*.mitre.org/*" }]
    }
  ]
}
